@startuml agent
!include ../c4.iuml

title Components: Agent

Container(transport, "Transport adapter", "Go module", "Sends protocol calls between processes.")
System_Ext(app, "Application server", "Implements Handler, the optional interfaces and the fence, and writes shard data.")

Container_Boundary(agent, "Agent") {
    Component(service, "Callback service", "replica, protocol", "Implements AgentServer: checks the caller against the cell record, and returns a transient error while that record is older than the caller's controller epoch. Refuses another namespace or node incarnation, a lower shard or controller epoch, and a superseded or ended operation, and returns the kept result of a repeated key. Starts a tenure only once the index watcher lists it. Runs one callback at a time per shard.")
    Component(dispatch, "Handler dispatch", "replica", "Calls Handler and the optional interfaces that the application implements, and lists them as capabilities.")
    Component(tokens, "Token issuer", "replica, fence", "Issues fencing tokens to writers, and acquires each tenure's fence before the writer reads.")
    Component(session, "Lease session", "membership, protocol", "Joins the node's cell with its identity, renews the lease, and stops writers at the lease deadline unless OnLoss is ContinueFenced. On Agent.Close, disrupts its own node, and leaves once its replicas have moved or its context ends.")
    Component(index, "Index watcher", "store", "Reads and watches the node's placements and the cell record, and restores non-writer replicas at start-up. For each tenure that its watched state stops listing, after an event or a replacement snapshot, it runs a local cleanup of that exact tenure while the tenure is still active.")
    Component(reporter, "Reporter", "replica, protocol", "Sends sequenced full snapshots of the node's replicas, load, capabilities and faults, and records the controller epoch of each reply. In the delegated mode, outside the support matrix, also sends the replicas and elections that the application reports.")
}

Container(adapters, "Store adapter", "Go module", "Implements store.Store and membership.Membership.")

Lay_R(transport, index)

Rel(transport, service, "Delivers the callbacks of the cell's controller", "AgentServer, through Dispatch")
Rel(service, dispatch, "Runs each accepted callback")
Rel(dispatch, app, "Adds, drops and re-roles replicas; in the delegated mode, asks the authority to elect or abdicate", "Handler, Elector")
Rel(app, tokens, "Takes a token before writing", "Agent.Token")
Rel(app, reporter, "Reports faults, and in the delegated mode the authority's replicas, elections and depositions", "ReportFault, Hosted, Released, Elected, Deposed")
Rel(tokens, app, "Acquires fences", "the application's fence.Guard")
Rel(reporter, transport, "Sends reports", "ControllerClient")
Rel(session, tokens, "Revokes tokens when the lease is lost under Stop")
Rel(index, service, "Provides the controller's identity and the node's listed tenures")
Rel(index, dispatch, "Restores non-writer replicas, and drops removed tenures that are still active")

Rel(index, adapters, "Reads and watches", "store.Store")
Rel(session, adapters, "Renews the node's lease", "membership.Membership")
Rel(session, transport, "Disrupts its own node on close", "Disrupt, Done")

SHOW_LEGEND()
@enduml
